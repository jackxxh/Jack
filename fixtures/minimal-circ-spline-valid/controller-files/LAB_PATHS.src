&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF LAB_PATHS()
  ; KLAB fixture: synthetic virtual-only CIRC + CP SPLINE seed
  BAS(#INITMOV,0)
  $ADVANCE=3
  $IPO_MODE=#BASE
  $ORI_TYPE=#VAR
  BAS(#TOOL,0)
  BAS(#BASE,0)
  $ACC.CP=1.0
  $VEL.ORI1=100
  $VEL.ORI2=100
  $ACC.ORI1=100
  $ACC.ORI2=100
  $APO.CDIS=0
  $APO.CPTP=0
  BAS(#VEL_PTP,20)
  BAS(#ACC_PTP,20)
  PTP A_HOME
  PTP P_START
  $VEL.CP=0.1
  CIRC P_AUX,P_ARC_END
  SPLINE
    SLIN P_SPLINE_1
    SPL P_SPLINE_2
    SCIRC P_SPLINE_AUX,P_SPLINE_END
  ENDSPLINE
END
