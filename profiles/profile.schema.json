{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KUKA Validation Lab environment profile",
  "type": "object",
  "required": ["id", "platform", "software"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "platform": {"type": "string", "enum": ["windows"]},
    "software": {
      "type": "object",
      "properties": {
        "kukaSim": {"$ref": "#/$defs/software"},
        "officeLite": {"$ref": "#/$defs/software"},
        "workVisual": {"$ref": "#/$defs/software"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "paths": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "software": {
      "type": "object",
      "required": ["enabled", "version"],
      "properties": {
        "enabled": {"type": "boolean"},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string"},
        "pathKey": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
